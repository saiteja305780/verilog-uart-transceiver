`timescale 1ns / 1ps

module uart_tx (
    input  wire       clk,
    input  wire       rst_n,

    input  wire [7:0] tx_data,
    input  wire       tx_start,

    output reg        tx_line,
    output reg        tx_busy,
    output reg        tx_done
);

    // FSM states
    localparam IDLE  = 2'd0;
    localparam START = 2'd1;
    localparam DATA  = 2'd2;
    localparam STOP  = 2'd3;

    reg [1:0] state;

    reg [7:0] shift_reg;
    reg [2:0] bit_count;

    wire baud_tick;

    // --------------------------------------------------
    // Baud generator
    // --------------------------------------------------

    baud_tick_gen #(
        .CLK_FREQ  (50_000_000),
        .BAUD_RATE (115200)
    ) baud_gen (
        .clk       (clk),
        .rst_n     (rst_n),
        .baud_tick (baud_tick)
    );

    // --------------------------------------------------
    // UART transmitter
    // --------------------------------------------------

    always @(posedge clk or negedge rst_n) begin

        if (!rst_n) begin

            state     <= IDLE;
            shift_reg <= 8'b0;
            bit_count <= 3'b0;

            tx_line   <= 1'b1;
            tx_busy   <= 1'b0;
            tx_done   <= 1'b0;

        end

        else begin

            // tx_done is a one-clock pulse
            tx_done <= 1'b0;

            case (state)

                // --------------------------------------
                // IDLE
                // --------------------------------------

                IDLE: begin

                    tx_line   <= 1'b1;
                    tx_busy   <= 1'b0;
                    bit_count <= 3'b0;

                    if (tx_start) begin

                        shift_reg <= tx_data;

                        tx_busy <= 1'b1;
                        state   <= START;

                    end

                end


                // --------------------------------------
                // START BIT
                // --------------------------------------

                START: begin

                    tx_line <= 1'b0;

                    if (baud_tick) begin
                        state <= DATA;
                    end

                end


                // --------------------------------------
                // DATA BITS
                // --------------------------------------

                DATA: begin

                    // Send LSB first
                    tx_line <= shift_reg[0];

                    if (baud_tick) begin

                        shift_reg <= shift_reg >> 1;

                        if (bit_count == 3'd7) begin

                            state <= STOP;

                        end
                        else begin

                            bit_count <= bit_count + 1'b1;

                        end

                    end

                end


                // --------------------------------------
                // STOP BIT
                // --------------------------------------

                STOP: begin

                    tx_line <= 1'b1;

                    if (baud_tick) begin

                        tx_busy <= 1'b0;
                        tx_done <= 1'b1;

                        state <= IDLE;

                    end

                end


                default: begin
                    state <= IDLE;
                end

            endcase

        end

    end

endmodule
