`timescale 1ns / 1ps

module uart_tb;

    // --------------------------------------------------
    // Clock and reset
    // --------------------------------------------------

    reg clk;
    reg rst_n;


    // --------------------------------------------------
    // TX
    // --------------------------------------------------

    reg  [7:0] tx_data;
    reg        tx_start;

    wire       tx_line;
    wire       tx_busy;
    wire       tx_done;


    // --------------------------------------------------
    // RX
    // --------------------------------------------------

    wire [7:0] rx_data;
    wire       rx_valid;


    // --------------------------------------------------
    // UART TX
    // --------------------------------------------------

    uart_tx tx_inst (

        .clk      (clk),
        .rst_n    (rst_n),

        .tx_data  (tx_data),
        .tx_start (tx_start),

        .tx_line  (tx_line),
        .tx_busy  (tx_busy),
        .tx_done  (tx_done)

    );


    // --------------------------------------------------
    // UART RX
    // --------------------------------------------------

    uart_rx rx_inst (

        .clk      (clk),
        .rst_n    (rst_n),

        .rx_line  (tx_line),

        .rx_data  (rx_data),
        .rx_valid (rx_valid)

    );


    // --------------------------------------------------
    // 50 MHz clock
    // --------------------------------------------------

    initial begin

        clk = 1'b0;

        forever #10 clk = ~clk;

    end


    // --------------------------------------------------
    // Test
    // --------------------------------------------------

    initial begin

        rst_n    = 1'b0;
        tx_data  = 8'h00;
        tx_start = 1'b0;

        // Reset
        #200;

        rst_n = 1'b1;

        // Wait
        #200;

        // Send 0x55
        tx_data  = 8'h55;
        tx_start = 1'b1;

        #20;

        tx_start = 1'b0;

        // Wait for complete TX + RX
        #100_000;

        $display("--------------------------------------");
        $display("SIMULATION FINISHED");
        $display("RX DATA  = 0x%h", rx_data);
        $display("RX VALID = %b", rx_valid);
        $display("--------------------------------------");

        $finish;

    end


    // --------------------------------------------------
    // RX monitor
    // --------------------------------------------------

    always @(posedge clk) begin

        if (rx_valid) begin

            $display(
                "RX RECEIVED: 0x%h at time %0t ns",
                rx_data,
                $time
            );

        end

    end

endmodule
