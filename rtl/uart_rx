`timescale 1ns / 1ps

module uart_rx (

    input  wire       clk,
    input  wire       rst_n,

    input  wire       rx_line,

    output reg [7:0]  rx_data,
    output reg        rx_valid
);

    // ---------------------------------------------
    // FSM states
    // ---------------------------------------------

    localparam IDLE  = 2'd0;
    localparam START = 2'd1;
    localparam DATA  = 2'd2;
    localparam STOP  = 2'd3;

    reg [1:0] state;


    // ---------------------------------------------
    // Registers
    // ---------------------------------------------

    reg [7:0] shift_reg;

    reg [2:0] bit_count;

    reg [15:0] baud_count;


    // 50 MHz / 115200 ≈ 434
    localparam integer BAUD_DIV = 434;

    // Half of one UART bit
    localparam integer HALF_BAUD = BAUD_DIV / 2;


    // ---------------------------------------------
    // UART Receiver
    // ---------------------------------------------

    always @(posedge clk or negedge rst_n) begin

        if (!rst_n) begin

            state      <= IDLE;

            shift_reg  <= 8'b0;
            bit_count  <= 3'b0;
            baud_count <= 16'b0;

            rx_data    <= 8'b0;
            rx_valid   <= 1'b0;

        end

        else begin

            // rx_valid is a one-clock pulse
            rx_valid <= 1'b0;


            case (state)

                // ---------------------------------
                // IDLE
                // ---------------------------------

                IDLE: begin

                    baud_count <= 0;
                    bit_count  <= 0;

                    // Start bit detected
                    if (rx_line == 1'b0) begin

                        state      <= START;
                        baud_count <= 0;

                    end

                end


                // ---------------------------------
                // START
                // ---------------------------------

                START: begin

                    if (baud_count == HALF_BAUD - 1) begin

                        baud_count <= 0;

                        // Check that it is still LOW
                        if (rx_line == 1'b0) begin

                            state <= DATA;

                        end
                        else begin

                            // False start
                            state <= IDLE;

                        end

                    end
                    else begin

                        baud_count <= baud_count + 1'b1;

                    end

                end


                // ---------------------------------
                // DATA
                // ---------------------------------

                DATA: begin

                    if (baud_count == BAUD_DIV - 1) begin

                        baud_count <= 0;

                        // Sample current data bit
                        shift_reg <= {rx_line, shift_reg[7:1]};

                        if (bit_count == 3'd7) begin

                            state <= STOP;

                        end
                        else begin

                            bit_count <= bit_count + 1'b1;

                        end

                    end
                    else begin

                        baud_count <= baud_count + 1'b1;

                    end

                end


                // ---------------------------------
                // STOP
                // ---------------------------------

                STOP: begin

                    if (baud_count == BAUD_DIV - 1) begin

                        baud_count <= 0;

                        // Stop bit should be HIGH
                        if (rx_line == 1'b1) begin

                            rx_data  <= shift_reg;
                            rx_valid <= 1'b1;

                        end

                        state <= IDLE;

                    end
                    else begin

                        baud_count <= baud_count + 1'b1;

                    end

                end


                default: begin

                    state <= IDLE;

                end

            endcase

        end

    end

endmodule
